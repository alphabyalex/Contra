# =====================================================================
# CONTRA — git ignore. NEVER commit secrets, keypairs, or build output.
# =====================================================================

# --- secrets (NEVER commit) ------------------------------------------
.env
.env.local
.env.*.local
authority.json
*.keypair.json
*-keypair.json
target/deploy/*-keypair.json
kalshi_private_key.pem
anthropic_key.txt
*.pem
*.p8
*.key

# --- node ------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- next.js ---------------------------------------------------------
.next/
out/
.vercel/

# --- anchor / solana / rust -----------------------------------------
target/
**/*.rs.bk
.anchor/
test-ledger/

# --- ml artifacts (regenerated from training) ------------------------
ml/artifacts/*.json
ml/__pycache__/
ml/*.pyc
*.pkl
*.tar.bz2

# --- price collector ------------------------------------------------
# Active CSVs churn constantly; resolved CSVs are permanent training data.
market_data/active/*.csv

# --- editor / OS -----------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
.claude/settings.local.json

# --- build / coverage ------------------------------------------------
dist/
build/
coverage/
*.log
tsconfig.tsbuildinfo
**/tsconfig.tsbuildinfo

# --- claude code session state --------------------------------------
.claude/scheduled_tasks.lock

# --- one-off dev / debug helpers (kept locally, never in main) ------
# Scratch artifacts produced by ad-hoc admin calls and local debugging.
basket-def.json
install-node.sh
install-yarn.sh
scripts/debug-init.ts
# Most wsl-*.sh helpers were workarounds for /mnt/c FS quirks, airdrop
# rate limits, etc. Keep the two that document the canonical deploy
# path (wsl-deploy-leverage.sh and wsl-sync-and-deploy.sh); ignore the rest.
wsl-airdrop-alt.sh
wsl-airdrop-patient.sh
wsl-anchor-build.sh
wsl-balance-multi-rpc.sh
wsl-build-native.sh
wsl-build-native2.sh
wsl-check-bal.sh
wsl-check-history.sh
wsl-deploy-tight.sh
wsl-deploy.sh
wsl-fresh-airdrop.sh
wsl-patch-anchor.sh
wsl-pin-pm2.sh
wsl-pm2-latest.sh
wsl-recover-buffer.sh
wsl-rpc-direct.sh
wsl-verify-deploy.sh
wsl-yarn-install.sh
