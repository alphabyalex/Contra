# =====================================================================
# CONTRA — environment variables
# Copy to .env and fill in. Never commit .env. All values are NEW —
# do not reuse anything from any prior project.
# =====================================================================

# ---- Solana ----------------------------------------------------------
# Devnet by default. Replace with a Helius devnet RPC URL for higher
# reliability (free tier is fine).
SOLANA_RPC_URL=https://api.devnet.solana.com

# JSON byte array of the authority keypair, e.g. [12,34,...] (64 numbers).
# Generate locally:  solana-keygen new --no-bip39-passphrase --outfile authority.json
# Then paste the contents of authority.json on a single line below.
AUTHORITY_KEYPAIR=

# ---- Program IDs -----------------------------------------------------
# Filled in AFTER `anchor deploy`. Leave blank until then; backend will
# refuse to build deposit txs without them.
CONTRA_VAULT_PROGRAM_ID=
CONTRA_LENDING_PROGRAM_ID=
CONTRA_LEVERAGE_PROGRAM_ID=

# Devnet USDC mint. The well-known devnet faucet mint is below — use it
# unless you have a reason to mint your own test USDC.
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# ---- Supabase --------------------------------------------------------
# Create a NEW project at https://supabase.com. Run backend/src/db/schema.sql
# in the SQL editor before first use. If any of these are missing the
# backend degrades to an in-memory mock (warns at startup, no crash).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ---- Kalshi (Phase 2 — primary data source) --------------------------
# Sign up at https://kalshi.com and request API access.
KALSHI_API_KEY=
KALSHI_BASE_URL=https://trading-api.kalshi.com/trade-api/v2

# ---- Polymarket (no key required) ------------------------------------
POLYMARKET_BASE_URL=https://gamma-api.polymarket.com

# ---- Helius (webhook for on-chain event ingestion) -------------------
# Optional but recommended. https://helius.dev
HELIUS_API_KEY=
HELIUS_WEBHOOK_SECRET=

# ---- Anthropic (optional — AI portfolio composer feature) -----------
ANTHROPIC_API_KEY=

# ---- Backend ---------------------------------------------------------
PORT=3001
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
